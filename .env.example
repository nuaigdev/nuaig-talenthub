# Copy to .env.local and fill in. Never commit real values.
# SETUP.md explains where each of these comes from.

# ---------------------------------------------------------------------------
# Entra ID / Microsoft Graph (app-only, client credentials)
# Used for every candidate-submission operation. The public portal has no user
# identity to act as, so the backend acts as the app itself.
# ---------------------------------------------------------------------------
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Entra ID (delegated, recruiter SSO — same app registration, different flow)
# NEXTAUTH_SECRET also keys the signed draft-upload tokens and the encrypted
# pagination cursors, so it must be set even in development.
# Generate one with:  openssl rand -base64 32
# ---------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# ---------------------------------------------------------------------------
# SharePoint (see SHAREPOINT_SETUP.md for how to find these IDs)
# ---------------------------------------------------------------------------
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_CANDIDATES_LIST_ID=
SHAREPOINT_COUNTERS_LIST_ID=
SHAREPOINT_RECRUITERS_LIST_ID=

# Optional. Recruiter-managed open positions. Leave blank to use the built-in
# defaults in src/lib/constants.ts until the Positions list exists.
SHAREPOINT_POSITIONS_LIST_ID=

# Optional sub-folder inside the document library. Leave unset when the library
# itself holds the year folders directly (the usual case).
SHAREPOINT_CANDIDATES_ROOT=

# ---------------------------------------------------------------------------
# Mail — the shared mailbox confirmation emails are sent from.
# The app registration needs Mail.Send scoped to this mailbox.
# ---------------------------------------------------------------------------
CONFIRMATION_MAILBOX_UPN=

# ---------------------------------------------------------------------------
# Upload limits (enforced server-side regardless of anything the client checks)
# ---------------------------------------------------------------------------
MAX_RESUME_SIZE_MB=10
MAX_VIDEO_SIZE_MB=500
ALLOWED_RESUME_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime

# ---------------------------------------------------------------------------
# Duplicate protection — same email + same position inside this many days.
# ---------------------------------------------------------------------------
DUPLICATE_WINDOW_DAYS=90

# ---------------------------------------------------------------------------
# Optional: shown as a "Having trouble? Contact us" link in the public header.
# Omit to hide the link entirely.
# ---------------------------------------------------------------------------
CONTACT_EMAIL=
